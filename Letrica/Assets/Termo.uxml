<ui:UXML xmlns="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/TermoStyle.uss?fileID=7433441132597879392&amp;guid=eac2e7999831fcc4088038d0969d6c9c&amp;type=3#TermoStyle" />
    <ui:VisualElement name="termo-screen-container" class="root-container root-container--termo">
        <ui:VisualElement name="game-header" class="game-header" style="right: 1100px; left: 0; top: 80px; height: 248px; width: 1200px;">
            <ui:Button name="menu-button" class="button button--icon button--secondary" style="width: 240px; height: 160px; right: -20px;">
                <ui:Label text="Menu" style="-unity-text-align: middle-center; padding-top: 30px; padding-right: 30px; padding-bottom: 30px; padding-left: 30px; font-size: 60px; top: -1px;" />
            </ui:Button>
            <ui:Button name="new-game-button" class="button button--secondary button--with-icon" style="bottom: 0; width: 480px; height: 160px; flex-direction: column;">
                <ui:Label text=" Nova Partida" style="font-size: 60px; padding-top: 30px; padding-bottom: 30px;" />
            </ui:Button>
            <ui:Button name="hint-button" class="button button--secondary button--with-icon" style="bottom: 0; width: 240px; height: 160px; left: -20px;">
                <ui:Label text="Dica" style="font-size: 60px; -unity-text-align: middle-center; padding-left: 30px; padding-right: 30px; padding-top: 30px; padding-bottom: 30px;" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="grid-container" class="grid-container" style="height: 1100px; width: 1180px; bottom: auto; top: 0; padding-top: 15px; margin-bottom: 0; padding-bottom: 15px; background-color: rgb(253, 247, 231);">
            <ui:VisualElement name="grid-row-0" class="grid-row" style="width: 1180px; flex-direction: row; flex-wrap: nowrap;">
                <ui:VisualElement name="cell-0-0" class="grid-cell" style="background-color: rgb(108, 193, 73); width: 160px; height: 160px;">
                    <ui:Label text="C" name="Label" style="width: 142px; height: 142px; -unity-text-align: middle-center; font-size: 60px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement name="cell-0-1" class="grid-cell" style="background-color: rgb(255, 215, 0); width: 160px; height: 160px;">
                    <ui:Label text="A" style="width: 142px; height: 142px; -unity-text-align: middle-center; font-size: 60px; -unity-font-style: bold; -unity-background-image-tint-color: rgb(255, 255, 255);" />
                </ui:VisualElement>
                <ui:VisualElement name="cell-0-2" class="grid-cell" style="background-color: rgb(181, 169, 149); width: 160px; height: 160px;">
                    <ui:Label text="I" style="width: 142px; height: 142px; -unity-text-align: middle-center; font-size: 60px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement name="cell-0-3" class="grid-cell" style="background-color: rgb(181, 169, 149); width: 160px; height: 160px;">
                    <ui:Label text="J" style="width: 142px; height: 142px; -unity-text-align: middle-center; font-size: 60px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement name="cell-0-4" class="grid-cell" style="background-color: rgb(255, 215, 0); width: 160px; height: 160px;">
                    <ui:Label text="O" style="width: 142px; height: 142px; -unity-text-align: middle-center; font-size: 60px; -unity-font-style: bold;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="grid-row-1" class="grid-row" style="width: 1180px;">
                <ui:VisualElement name="cell-0-0" class="grid-cell" style="background-color: rgb(108, 193, 73); width: 160px; height: 160px;">
                    <ui:Label text="C" style="width: 150px; height: 150px; -unity-text-align: middle-center; font-size: 60px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement name="cell-0-1" class="grid-cell" style="background-color: rgb(108, 193, 73); width: 160px; height: 160px;">
                    <ui:Label text="O" style="width: 150px; height: 150px; -unity-text-align: middle-center; font-size: 60px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement name="cell-0-2" class="grid-cell" style="background-color: rgb(255, 215, 0); width: 160px; height: 160px;">
                    <ui:Label text="L" style="width: 150px; height: 150px; -unity-text-align: middle-center; font-size: 60px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement name="cell-0-3" class="grid-cell" style="background-color: rgb(108, 193, 73); width: 160px; height: 160px;">
                    <ui:Label text="A" style="width: 150px; height: 150px; -unity-text-align: middle-center; font-size: 60px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement name="cell-0-4" class="grid-cell" style="background-color: rgb(255, 215, 0); width: 160px; height: 160px;">
                    <ui:Label text="R" style="width: 150px; height: 150px; -unity-text-align: middle-center; font-size: 60px; -unity-font-style: bold;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="grid-row-2" class="grid-row" style="width: 1180px;">
                <ui:VisualElement name="cell-0-0" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-1" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-2" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-3" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-4" class="grid-cell" style="height: 160px; width: 160px;" />
            </ui:VisualElement>
            <ui:VisualElement name="grid-row-3" class="grid-row" style="width: 1180px;">
                <ui:VisualElement name="cell-0-0" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-1" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-2" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-3" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-4" class="grid-cell" style="width: 160px; height: 160px;" />
            </ui:VisualElement>
            <ui:VisualElement name="grid-row-4" class="grid-row" style="width: 1180px;">
                <ui:VisualElement name="cell-0-0" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-1" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-2" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-3" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-4" class="grid-cell" style="width: 160px; height: 160px;" />
            </ui:VisualElement>
            <ui:VisualElement name="grid-row-5" class="grid-row" style="width: 1180px;">
                <ui:VisualElement name="cell-0-0" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-1" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-2" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-3" class="grid-cell" style="width: 160px; height: 160px;" />
                <ui:VisualElement name="cell-0-4" class="grid-cell" style="width: 160px; height: 160px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="keyboard-container" class="keyboard-container" style="bottom: -64px; margin-bottom: 0; height: 440px;">
            <ui:VisualElement name="keyboard-row-1" class="keyboard-row" style="-unity-font-style: bold; height: 140px;">
                <ui:Button text="Q" name="key-Q" class="key" />
                <ui:Button text="W" name="key-W" class="key" />
                <ui:Button text="E" name="key-E" class="key" />
                <ui:Button text="R" name="key-R" class="key" style="background-color: rgb(255, 179, 71);" />
                <ui:Button text="T" name="key-T" class="key" />
                <ui:Button text="Y" name="key-Y" class="key" />
                <ui:Button text="U" name="key-U" class="key" />
                <ui:Button text="I" name="key-I" class="key" style="background-color: rgb(180, 169, 149);" />
                <ui:Button text="O" name="key-O" class="key" style="background-color: rgb(255, 179, 71);" />
                <ui:Button text="P" name="key-P" class="key" />
            </ui:VisualElement>
            <ui:VisualElement name="keyboard-row-2" class="keyboard-row" style="-unity-font-style: bold; height: 140px;">
                <ui:Button text="A" name="key-A" class="key" style="background-color: rgb(255, 179, 71);" />
                <ui:Button text="S" name="key-S" class="key" />
                <ui:Button text="D" name="key-D" class="key" />
                <ui:Button text="F" name="key-F" class="key" />
                <ui:Button text="G" name="key-G" class="key" />
                <ui:Button text="H" name="key-H" class="key" />
                <ui:Button text="J" name="key-J" class="key" style="background-color: rgb(181, 169, 149);" />
                <ui:Button text="K" name="key-K" class="key" />
                <ui:Button text="L" name="key-L" class="key" style="background-color: rgb(255, 179, 71);" />
            </ui:VisualElement>
            <ui:VisualElement name="keyboard-row-3" class="keyboard-row" style="-unity-font-style: bold; height: 140px;">
                <ui:Button text="Z" name="key-Z" class="key" />
                <ui:Button text="X" name="key-X" class="key" />
                <ui:Button text="C" name="key-C" class="key" style="background-color: rgb(255, 179, 71);" />
                <ui:Button text="V" name="key-V" class="key" />
                <ui:Button text="B" name="key-B" class="key" />
                <ui:Button text="N" name="key-N" class="key" />
                <ui:Button text="M" name="key-M" class="key" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="action-buttons-container" class="action-buttons-container" style="bottom: -89px; width: 1100px; height: 251px;">
            <ui:Button text="Apagar" name="backspace-button" class="button button--action" style="font-size: 60px; top: 100px; width: 300px; height: 160px; left: -60px; background-color: rgba(0, 0, 0, 0.15); color: rgb(255, 255, 255);" />
            <ui:Button text="Enviar" name="submit-button" class="button button--action button--primary" style="font-size: 60px; top: 100px; height: 160px; width: 300px; right: -60px; background-color: rgba(0, 0, 0, 0.15); color: rgb(255, 255, 255);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
