:root {
    --color-bg-light: rgb(251, 245, 238);
    --color-bg-termo: rgb(195, 107, 86);
    --color-bg-sudoku: rgb(115, 138, 94);
    --color-panel-bg: rgb(245, 239, 227);
    --color-key-bg: rgb(234, 225, 211);
    --color-key-bg-secondary: rgb(217, 210, 198);
    --color-text-dark: rgb(74, 63, 53);
    --color-text-secondary: rgb(138, 127, 115);
    --color-text-light: rgb(255, 255, 255);
    --color-grid-line: rgb(217, 205, 191);
    --color-termo-action: rgb(163, 91, 72);
    --radius-s: 8px;
    --radius-m: 12px;
    --radius-l: 20px;
    --radius-xl: 30px;
}

.root-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 30px;
    width: 100%;
    height: 100%;
}

.title-h1 {
    font-size: 48px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
}

.subtitle {
    font-size: 18px;
    color: var(--color-text-secondary);
    margin-bottom: 30px;
}

.button {
    border-width: 0;
    background-color: transparent;
    -unity-font-style: bold;
    color: var(--color-text-dark);
    font-size: 18px;
    padding: 10px 15px;
    border-radius: var(--radius-m);
}

.button:hover {
    scale: 1.05;
}

.button:active {
    scale: 0.98;
}

.button--with-icon {
    flex-direction: row;
    align-items: center;
}

.icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.grid-container {
    background-color: var(--color-panel-bg);
    border-radius: var(--radius-l);
    padding: 15px;
    -unity-slice-left: 5;
    -unity-slice-top: 5;
    -unity-slice-right: 5;
    -unity-slice-bottom: 5;
    margin-bottom: 25px;
}

.game-controls-container {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 25px;
}

.game-controls-container .button {
    margin: 0 10px;
    border-radius: var(--radius-xl);
    padding: 10px 20px;
    font-size: 16px;
    flex-direction: row;
    align-items: center;
}

.action-buttons-container {
    flex-direction: row;
    justify-content: center;
}

.main-menu-container {
    background-color: var(--color-bg-light);
}

.header-container {
    align-items: center;
    margin-bottom: 20px;
}

.game-select-container {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 30px;
}

.game-button {
    width: 200px;
    height: 220px;
    padding: 20px;
    margin: 0 15px;
    border-radius: var(--radius-l);
    align-items: center;
    justify-content: space-around;
}

.game-button--termo {
    background-color: var(--color-bg-termo);
}

.game-button--sudoku {
    background-color: var(--color-bg-sudoku);
}

.game-button .icon-container {
    width: 80px;
    height: 80px;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-m);
    align-items: center;
    justify-content: center;
}

.game-button .icon {
    width: 40px;
    height: 40px;
    margin: 0;
}

.game-button Label {
    color: var(--color-text-light);
}

.game-button__title {
    font-size: 24px;
    -unity-font-style: bold;
}

.game-button__description {
    font-size: 16px;
}

.footer-container {
    align-items: center;
}

.main-menu-container .button {
    background-color: var(--color-text-light);
    border-width: 1px;
    border-color: var(--color-grid-line);
    border-radius: var(--radius-xl);
    padding: 10px 20px;
    color: var(--color-text-secondary);
    font-size: 16px;
}

.game-header {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    position: absolute;
    top: 20px;
    left: 20px;
    right: 20px;
}

.game-header .title-h1 {
    color: var(--color-text-light);
    margin-bottom: 0;
}

.header-spacer {
    width: 90px;
}

.game-header .button {
    border-radius: var(--radius-xl);
    padding: 8px 18px;
    font-size: 16px;
    color: var(--color-text-light);
}

.root-container--termo {
    background-color: var(--color-bg-termo);
}

.root-container--termo .game-header .button {
    background-color: rgba(0, 0, 0, 0.15);
}

.root-container--termo .game-controls-container .button {
    background-color: var(--color-panel-bg);
    color: var(--color-bg-termo);
}

.grid-row {
    flex-direction: row;
    justify-content: center;
    width: 1200px;
    height: 500px;
}

.grid-cell {
    width: 160px;
    height: 160px;
    background-color: var(--color-text-light);
    border-radius: var(--radius-s);
    margin: 4px;
    border-width: 2px;
    border-color: var(--color-key-bg);
    font-size: 60px;
}

.keyboard-container {
    align-items: center;
    margin-bottom: 20px;
    width: 1130px;
    height: 853px;
}

.keyboard-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 8px;
    width: 1130px;
    height: 853px;
}

.key {
    width: 112px;
    height: 120px;
    border-radius: var(--radius-s);
    margin: 0 3px;
    font-size: 60px;
    color: var(--color-text-dark);
    background-color: rgb(253, 247, 231);
}

.key:hover {
    background-color: var(--color-key-bg-secondary);
}

.root-container--termo .action-buttons-container .button {
    background-color: var(--color-key-bg);
    color: var(--color-text-dark);
    border-radius: var(--radius-s);
    margin: 0 5px;
    padding: 12px 20px;
    font-size: 16px;
}

.root-container--termo .button--primary {
    background-color: var(--color-termo-action);
    color: var(--color-text-light);
}

.root-container--sudoku {
    background-color: var(--color-bg-sudoku);
}

.root-container--sudoku .game-header .button {
    background-color: rgba(255, 255, 255, 0.2);
}

.root-container--sudoku .game-controls-container .button {
    background-color: var(--color-key-bg);
    color: var(--color-text-dark);
}

.grid-container--sudoku {
    padding: 10px;
}

.sudoku-row {
    flex-direction: row;
}

.sudoku-cell {
    width: 40px;
    height: 40px;
    border-width: 1px;
    border-color: var(--color-grid-line);
    align-items: center;
    justify-content: center;
}

.sudoku-cell--border-right {
    border-right-width: 3px;
    border-right-color: var(--color-text-dark);
}

.sudoku-row--border-bottom .sudoku-cell {
    border-bottom-width: 3px;
    border-bottom-color: var(--color-text-dark);
}

.cell-number {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--color-text-dark);
}

.cell-number--user {
    color: var(--color-bg-sudoku);
}

.numpad-container {
    align-items: center;
    margin-bottom: 20px;
}

.numpad-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 10px;
}

.numpad-key {
    width: 65px;
    height: 55px;
    background-color: var(--color-key-bg);
    border-radius: var(--radius-m);
    margin: 0 5px;
    font-size: 24px;
    color: var(--color-text-dark);
}

.numpad-key:hover {
    background-color: var(--color-key-bg-secondary);
}

.root-container--sudoku .button--long {
    background-color: var(--color-key-bg);
    color: var(--color-text-dark);
    border-radius: var(--radius-m);
    width: 355px;
    padding: 12px 20px;
    font-size: 16px;
}
