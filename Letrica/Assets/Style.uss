/* ================= GERAL ================= */
.root-container {
    flex-grow: 1;
    background-color: #738A5E; /* Verde Musgo */
    align-items: center;
    justify-content: space-between; /* Espalha Header, Grid e Footer */
    padding: 20px 0; /* Margem em cima e embaixo */
}

.game-title {
    font-size: 40px;
    color: white;
    -unity-font-style: bold;
}

/* ================= BOTÕES ================= */
.button-rounded {
    background-color: #D9D2C6; /* Bege Claro */
    border-radius: 20px;
    border-width: 0;
    padding: 10px 20px;
    font-size: 16px;
    color: #4A3F35;
    -unity-font-style: bold;
    margin: 5px;
}

.button-small {
    width: 80px;
    height: 60px;
    white-space: normal; /* Permite quebra de linha se precisar */
}

.button-wide {
    width: 250px;
    margin-top: 20px;
}

.button-numpad {
    width: 50px;
    height: 50px;
    background-color: #EAE1D3;
    border-radius: 10px;
    margin: 5px;
    font-size: 24px;
    color: #4A3F35;
    border-width: 0;
}

/* ================= HEADER ================= */
.header-top {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
    height: 80px;
}

.header-actions {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 10px;
}

/* ================= GRID SUDOKU (IMPORTANTE) ================= */
.sudoku-main-board {
    /* 1. LARGURA RESPONSIVA: 
       Isso diz: "Seja 95% da largura da tela, MAS não passe de 500px" */
    width: 95%;
    max-width: 500px;

    /* 2. QUADRADO PERFEITO:
       Isso garante que a altura acompanhe a largura automaticamente */
    aspect-ratio: 1;

    background-color: #F5EFE3;
    border-radius: 15px;
    padding: 5px;

    /* 3. GRID LAYOUT: Faz os blocos ficarem lado a lado */
    flex-direction: row;
    flex-wrap: wrap;
    
    /* Centraliza caso sobre espaço */
    align-self: center; 
}

/* OS BLOCOS 3x3 (Grid dentro de Grid) */
.sudoku-block {
    width: 33.33%;  /* 1/3 do tamanho do pai */
    height: 33.33%; /* 1/3 do tamanho do pai */
    
    /* Linha GROSSA Externa */
    border-width: 2px;
    border-color: #4A3F35; /* Marrom Escuro */
    
    /* Layout das células internas */
    flex-direction: row;
    flex-wrap: wrap;
    
    margin: 0;
    padding: 0;
}

/* AS CÉLULAS INDIVIDUAIS */
.sudoku-cell {
    width: 33.33%;
    height: 33.33%;
    
    /* Linha FINA Interna */
    border-width: 0.5px;
    border-color: #8A7F73; /* Marrom Claro */
    
    align-items: center;
    justify-content: center;
}

.cell-text {
    font-size: 28px;
    -unity-font-style: bold;
    color: #4A3F35;
}

/* ================= FOOTER ================= */
.footer-container {
    align-items: center;
    justify-content: center;
    width: 100%;
    padding-bottom: 20px;
}

.numpad-row {
    flex-direction: row;
    justify-content: center;
}