<ui:UXML xmlns="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/StyleMenu.uss?fileID=7433441132597879392&amp;guid=a0a0dcf309dba5a4baf3ca0e399ca5d6&amp;type=3#StyleMenu" />
    <ui:VisualElement name="main-menu-container" class="root-container">
        <ui:VisualElement name="header-container" class="header-container">
            <ui:Label text="Letrica" name="main-title" class="title-h1" />
            <ui:Label text="JOGOS PARA A MENTE" name="subtitle" class="subtitle" />
        </ui:VisualElement>
        <ui:VisualElement name="game-select-container" class="game-select-container">
            <ui:Button name="termo-button" class="game-button game-button--termo">
                <ui:VisualElement name="termo-icon-container" class="icon-container">
                    <ui:VisualElement name="termo-icon" class="icon icon--brain" />
                </ui:VisualElement>
                <ui:Label text="TERMO" class="game-button__title" />
                <ui:Label text="Adivinhe palavras" class="game-button__description" />
            </ui:Button>
            <ui:Button name="sudoku-button" class="game-button game-button--sudoku">
                <ui:VisualElement name="sudoku-icon-container" class="icon-container">
                    <ui:VisualElement name="sudoku-icon" class="icon icon--grid" />
                </ui:VisualElement>
                <ui:Label text="SUDOKU" class="game-button__title" />
                <ui:Label text="Grade de números" class="game-button__description" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="footer-container" class="footer-container">
            <ui:Button name="settings-button" class="button button--secondary button--with-icon">
                <ui:VisualElement name="settings-icon" class="icon icon--settings" />
                <ui:Label text="Configurações" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
