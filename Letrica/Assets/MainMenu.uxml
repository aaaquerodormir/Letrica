<ui:UXML xmlns="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/StyleMenu.uss?fileID=7433441132597879392&amp;guid=a0a0dcf309dba5a4baf3ca0e399ca5d6&amp;type=3#StyleMenu" />
    <ui:VisualElement name="main-menu-container" class="root-container" style="background-color: rgb(255, 236, 179);">
        <ui:VisualElement name="header-container" class="header-container" style="margin-top: 250px; margin-bottom: 391px; align-items: center; justify-content: center; background-color: rgb(253, 247, 231); border-radius: 15px; padding: 20px; padding-right: 120px; padding-left: 120px; padding-top: 30px; padding-bottom: 30px; border-left-color: rgb(255, 179, 71); border-right-color: rgb(255, 179, 71); border-top-color: rgb(255, 179, 71); border-bottom-color: rgb(255, 179, 71); border-bottom-width: 25px; border-top-width: 0;">
            <ui:Label text="LETRICA" name="main-title" class="title-h1" style="font-size: 140px; color: rgb(74, 74, 74); -unity-font-style: bold; margin-bottom: 60px; border-left-color: rgb(255, 179, 71); border-right-color: rgb(255, 179, 71); border-top-color: rgb(255, 179, 71); border-bottom-color: rgb(255, 179, 71); border-bottom-width: 0; margin-top: 8px;" />
            <ui:Label text="JOGOS PARA A MENTE" name="subtitle" class="subtitle" style="font-size: 70px; color: rgb(74, 74, 74); -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; border-top-width: 0; border-left-color: rgb(255, 179, 71); border-right-color: rgb(255, 179, 71); border-top-color: rgb(255, 179, 71); border-bottom-color: rgb(255, 179, 71);" />
        </ui:VisualElement>
        <ui:VisualElement name="game-select-container" class="game-select-container">
            <ui:Button name="termo-button" class="game-button game-button--termo" style="height: 700px; width: 400px; margin-right: 130px; border-left-color: rgb(186, 81, 56); border-right-color: rgb(186, 81, 56); border-top-color: rgb(186, 81, 56); border-bottom-color: rgb(186, 81, 56); border-bottom-width: 20px; border-right-width: 15px; border-top-width: 15px; border-left-width: 15px;">
                <ui:VisualElement name="termo-icon-container" class="icon-container" style="width: 300px; height: 300px;">
                    <ui:Label text="A" class="game-button__title" style="font-size: 200px;" />
                </ui:VisualElement>
                <ui:Label text="TERMO" class="game-button__title" style="font-size: 60px;" />
                <ui:Label text="Adivinhe palavras" class="game-button__description" style="font-size: 45px; white-space: normal;" />
            </ui:Button>
            <ui:Button name="sudoku-button" class="game-button game-button--sudoku" style="height: 700px; width: 400px; margin-left: 40px; border-top-width: 15px; border-right-width: 15px; border-left-width: 15px; border-bottom-width: 20px; border-left-color: rgb(97, 126, 70); border-right-color: rgb(97, 126, 70); border-top-color: rgb(97, 126, 70); border-bottom-color: rgb(97, 126, 70);">
                <ui:VisualElement name="sudoku-icon-container" class="icon-container" style="width: 300px; height: 300px;">
                    <ui:Label text="1" class="game-button__title" style="font-size: 200px;" />
                </ui:VisualElement>
                <ui:Label text="SUDOKU" class="game-button__title" style="font-size: 60px;" />
                <ui:Label text="Grade de números" class="game-button__description" style="font-size: 45px; white-space: normal; -unity-font-style: normal; -unity-text-align: middle-center;" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="footer-container" class="footer-container">
            <ui:Button name="config-button" class="game-button game-button--sudoku" style="height: 140px; width: 800px; background-color: rgb(255, 179, 71); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 6px; border-left-width: 2px; border-left-color: rgb(147, 70, 19); border-right-color: rgb(147, 70, 19); border-top-color: rgb(147, 70, 19); border-bottom-color: rgb(147, 70, 19); margin-top: 270px; margin-bottom: 100px;">
                <ui:Label text="CONFIGURAÇÕES" style="font-size: 60px; color: rgb(126, 59, 10); -unity-font-style: bold; -unity-text-align: middle-center; justify-content: center; align-items: center; align-self: center; align-content: center; margin-top: 20px;" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
