            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="numpad-container">
            <ui:VisualElement class="numpad-row">
                <ui:Button text="1" name="numpad-1" class="button numpad-key" />
                <ui:Button text="2" name="numpad-2" class="button numpad-key" />
                <ui:Button text="3" name="numpad-3" class="button numpad-key" />
                <ui:Button text="4" name="numpad-4" class="button numpad-key" />
                <ui:Button text="5" name="numpad-5" class="button numpad-key" />
            </ui:VisualElement>
            <ui:VisualElement class="numpad-row">
                <ui:Button text="6" name="numpad-6" class="button numpad-key" />
                <ui:Button text="7" name="numpad-7" class="button numpad-key" />
                <ui:Button text="8" name="numpad-8" class="button numpad-key" />
                <ui:Button text="9" name="numpad-9" class="button numpad-key" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Button text="Limpar Célula" name="clear-cell-button" class="button button--long" />

    </ui:VisualElement>
</ui:UXML>