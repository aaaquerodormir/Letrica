                <ui:VisualElement name="cell-7-5" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-7-6" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-7-7" class="sudoku-cell"><ui:Label text="3" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-7-8" class="sudoku-cell"><ui:Label text="5" class="cell-number" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="grid-row-8" class="sudoku-row">
                <ui:VisualElement name="cell-8-0" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-8-1" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-8-2" class="sudoku-cell"><ui:Label text="5" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-8-3" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-8-4" class="sudoku-cell"><ui:Label text="8" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-8-5" class="sudoku-cell"><ui:Label text="6" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-8-6" class="sudoku-cell"><ui:Label text="1" class="cell-number" /></ui:VisualElement>
