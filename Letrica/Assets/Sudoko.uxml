<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEngine.UIElements.Editor">

    <ui:VisualElement class="root-container root-container--sudoku">
        
        <ui:VisualElement class="game-header">
            <ui:Button text="Menu" name="menu-button" class="button button--with-icon" />
            <ui:Label text="SUDOKU" class="title-h1" />
            <ui:VisualElement class="header-spacer" /> 
        </ui:VisualElement>

        <ui:VisualElement class="game-controls-container">
            <ui:Button text="Dica" name="hint-button" class="button button--with-icon" />
            <ui:Button text="Nova Partida" name="new-game-button" class="button" />
        </ui:VisualElement>

        <ui:VisualElement name="sudoku-grid-container" class="grid-container grid-container--sudoku">
            
            <ui:VisualElement class="sudoku-grid-lines-container">
                
                <ui:VisualElement class="sudoku-thick-line sudoku-thick-line--vertical" 
                    style="left: 133px; top: 10px; height: 388px;" />
                
                <ui:VisualElement class="sudoku-thick-line sudoku-thick-line--vertical" 
                    style="left: 256px; top: 10px; height: 388px;" />

                <ui:VisualElement class="sudoku-thick-line sudoku-thick-line--horizontal" 
                    style="top: 133px; left: 10px; width: 388px;" />
                
                <ui:VisualElement class="sudoku-thick-line sudoku-thick-line--horizontal" 
                    style="top: 256px; left: 10px; width: 388px;" />
            </ui:VisualElement>

            <ui:VisualElement name="grid-row-0" class="sudoku-row">
                <ui:VisualElement name="cell-0-0" class="sudoku-cell"><ui:Label text="5" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-0-1" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-0-2" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-0-3" class="sudoku-cell"><ui:Label text="6" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-0-4" class="sudoku-cell"><ui:Label text="7" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-0-5" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-0-6" class="sudoku-cell"><ui:Label text="9" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-0-7" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-0-8" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="grid-row-1" class="sudoku-row">
                <ui:VisualElement name="cell-1-0" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-1-1" class="sudoku-cell"><ui:Label text="2" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-1-2" class="sudoku-cell"><ui:Label text="1" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-1-3" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-1-4" class="sudoku-cell"><ui:Label text="5" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-1-5" class="sudoku-cell"><ui:Label text="3" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-1-6" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-1-7" class="sudoku-cell"><ui:Label text="8" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-1-8" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="grid-row-2" class="sudoku-row">
                <ui:VisualElement name="cell-2-0" class="sudoku-cell"><ui:Label text="1" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-2-1" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-2-2" class="sudoku-cell"><ui:Label text="8" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-2-3" class="sudoku-cell"><ui:Label text="3" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-2-4" class="sudoku-cell"><ui:Label text="4" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-2-5" class="sudoku-cell"><ui:Label text="2" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-2-6" class="sudoku-cell"><ui:Label text="5" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-2-7" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-2-8" class="sudoku-cell"><ui:Label text="7" class="cell-number" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="grid-row-3" class="sudoku-row">
                <ui:VisualElement name="cell-3-0" class="sudoku-cell"><ui:Label text="8" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-3-1" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-3-2" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-3-3" class="sudoku-cell"><ui:Label text="7" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-3-4" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-3-5" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-3-6" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-3-7" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-3-8" class="sudoku-cell"><ui:Label text="3" class="cell-number" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="grid-row-4" class="sudoku-row">
                <ui:VisualElement name="cell-4-0" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-4-1" class="sudoku-cell"><ui:Label text="2" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-4-2" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-4-3" class="sudoku-cell"><ui:Label text="8" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-4-4" class="sudoku-cell"><ui:Label text="5" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-4-5" class="sudoku-cell"><ui:Label text="3" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-4-6" class="sudoku-cell"><ui:Label text="7" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-4-7" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-4-8" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="grid-row-5" class="sudoku-row">
                <ui:VisualElement name="cell-5-0" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-5-1" class="sudoku-cell"><ui:Label text="1" class="cell-number" /></ui:VisualElement> 
                <ui:VisualElement name="cell-5-2" class="sudoku-cell"><ui:Label text="3" class="cell-number" /></ui:VisualElement> 
