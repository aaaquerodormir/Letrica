                <ui:VisualElement name="cell-5-5" class="sudoku-cell"><ui:Label text="4" class="cell-number" /></ui:VisualElement> 
                <ui:VisualElement name="cell-5-6" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement> 
                <ui:VisualElement name="cell-5-7" class="sudoku-cell"><ui:Label text="5" class="cell-number" /></ui:VisualElement> 
                <ui:VisualElement name="cell-5-8" class="sudoku-cell"><ui:Label text="6" class="cell-number" /></ui:VisualElement> 
            </ui:VisualElement>
            <ui:VisualElement name="grid-row-6" class="sudoku-row">
                <ui:VisualElement name="cell-6-0" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-6-1" class="sudoku-cell"><ui:Label text="6" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-6-2" class="sudoku-cell"><ui:Label text="1" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-6-3" class="sudoku-cell"><ui:Label text="5" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-6-4" class="sudoku-cell"><ui:Label text="3" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-6-5" class="sudoku-cell"><ui:Label text="7" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-6-6" class="sudoku-cell"><ui:Label text="2" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-6-7" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-6-8" class="sudoku-cell"><ui:Label text="4" class="cell-number" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="grid-row-7" class="sudoku-row">
                <ui:VisualElement name="cell-7-0" class="sudoku-cell"><ui:Label text="2" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-7-1" class="sudoku-cell"><ui:Label text="8" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-7-2" class="sudoku-cell"><ui:Label text="7" class="cell-number" /></ui:VisualElement>
                <ui:VisualElement name="cell-7-3" class="sudoku-cell"><ui:Label class="cell-number" /></ui:VisualElement>
